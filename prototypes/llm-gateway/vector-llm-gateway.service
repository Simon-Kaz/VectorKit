[Unit]
Description=Vector LLM gateway (wire-pod knowledge backend)
# The gateway proxies wire-pod's knowledge stream to the local Ollama server,
# so it must start after Ollama and the network are up.
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=vector
Group=vector
WorkingDirectory=/home/vector/VectorKit/prototypes/llm-gateway
EnvironmentFile=/home/vector/VectorKit/prototypes/llm-gateway/.env
ExecStart=/home/vector/VectorKit/prototypes/llm-gateway/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

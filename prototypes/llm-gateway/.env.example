# Copy to .env (gitignored) and fill in. NEVER commit a real key.
#   cp .env.example .env

# Which backend the gateway uses: "claude" (cloud) or "ollama" (local).
# Switch this + restart to change Vector's brain -- no wire-pod change.
LLM_BACKEND=claude

# Max output tokens (spoken answers are short; also bounds cost/latency).
MAX_TOKENS=1024

# Port the gateway listens on (wire-pod's endpoint points here).
GATEWAY_PORT=8088

# --- claude backend (LLM_BACKEND=claude) --------------------------------
# Sends the transcript to Anthropic -- leaves the LAN. Needs a personal key.
ANTHROPIC_API_KEY=
#   claude-haiku-4-5  -> fastest / cheapest, good for short spoken answers (default)
#   claude-opus-4-8   -> richer answers
CLAUDE_MODEL=claude-haiku-4-5

# --- ollama backend (LLM_BACKEND=ollama) --------------------------------
# Fully local: no API key, transcript never leaves the LAN. Needs an Ollama
# server (`ollama serve`) with the model pulled (`ollama pull <model>`).
# The gateway sends `think: false`, so reasoning models (gemma4, deepseek-r1)
# answer directly instead of spending the token budget on hidden thinking.
# Model size is bounded by the host's free RAM. Our vector-pod is a 2 GB Pi 4B
# already running wire-pod (~1.2 GB free), so a sub-1B model is what actually
# fits: qwen2.5:0.5b (verified on the Pi, ~1.2 GB resident, ~7s cold / ~1s warm).
# A ~1B model (llama3.2:1b) needs ~1.3 GB and spills to SD swap there -- fine on
# a 4 GB+ host or the dev Mac, too tight alongside wire-pod on 2 GB.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
